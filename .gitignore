# Local releases and machine-specific launchers
/release/
*.lnk
*.exe
*.log

# The packaged native helper is a build product, but the theme bundle must ship it, so it is
# the one deliberate exception: `npm pack` copies assets/wallpaper verbatim.
!dsh-whale-mist/assets/wallpaper/*.exe

# Local test/backup scratch space
/.tmp/
/NEXT_TASK.md
/dsh-whale-mist/*.tgz
/dsh-whale-gitbash/*.tgz
# Check output: the contract check writes its result next to the script by default.
/dsh-whale-mist/qa/wallpaper/sdk-contract-result.json

# Dependency and build caches
**/node_modules/
**/target/
/whale-desktop/runtime/node/node.exe
/whale-desktop/src-tauri/gen/

# Local Harness/user data and test homes
.dsh/
**/.runtime-test-home/
**/.desktop-test-home/
**/.portable-test-home/

# Secrets and local environment
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

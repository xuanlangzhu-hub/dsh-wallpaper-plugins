<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DailyFixedCanvas</AssemblyName>
    <StartupObject>DailyFixedCanvas</StartupObject>
    <DebugType>none</DebugType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Windows.SDK.NET"><HintPath>../../package/assets/wallpaper/Microsoft.Windows.SDK.NET.dll</HintPath></Reference>
    <Reference Include="WinRT.Runtime"><HintPath>../../package/assets/wallpaper/WinRT.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>

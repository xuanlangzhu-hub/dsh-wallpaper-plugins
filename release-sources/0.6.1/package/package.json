{
  "name": "dsh-whale-mist",
  "version": "0.6.1",
  "description": "Whale Appearance themes and wallpaper backgrounds for DeepSeek Harness Desktop",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
